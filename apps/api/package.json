{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "gen-openapi": "tsx scripts/gen-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/expo": "^1.7.12",
    "@hono/standard-validator": "^0.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.13",
    "hono-openapi": "^1.2.0",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/node": "^22.19.3",
    "@vitest/coverage-istanbul": "^4.1.12",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
